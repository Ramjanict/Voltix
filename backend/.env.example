# Database (Neon Serverless PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="your_jwt_secret_here"
TOKEN_SECRET_KEY="your_token_secret_here"

# Allowed Frontend URLs for CORS (comma-separated)
FRONTEND_URL="http://localhost:3000,https://your-domain.vercel.app"

# Stripe Secret Key (Payments)
STRIPE_SECRET_KEY="sk_test_..."

# Port
PORT=8080
